# 설정과 비밀값
.env
.env.*
!.env.example

# 의존성
node_modules/

# 입력: 논문 PDF와 원문에서 나온 것(저작권·비공개). 폴더 구조만 커밋
input/*
!input/.gitkeep

# 출력: 다시 만들 수 있는 결과물(HTML, PPTX, 캡처, 보고서, 실험 결과)
output/*
!output/.gitkeep

# 혹시 작업 원고 폴더에 들어간 원문·결과물
papers/*/source.pdf
papers/*/01_extract/
papers/*/sources/
papers/*/export/
papers/*/*.pptx
*.pdf
# 단, Claude Code 웹으로 보낼 PDF는 inbox/ 에 올린다(저장소는 반드시 Private)
!inbox/*.pdf

# 비공개 논문의 작업 원고(기관 데이터·비공개 리뷰 포함)
papers/dashboard/

# 백업과 OS·편집기 파일
*.tar.gz
*.zip
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
__pycache__/
.venv/
