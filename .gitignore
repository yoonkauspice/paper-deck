# 설정과 비밀값
.env
.env.*
!.env.example

# 의존성
node_modules/

# PC 전용 폴더(GitHub에 올리지 않음)
#  input/  : 논문 PDF와 원문에서 나온 것(저작권·비공개)
#  output/ : 빌드 중간 결과(언제든 다시 만들 수 있음). 최종본은 papers/<논문>/final/ 에 커밋
input/
output/

# 혹시 작업 원고 폴더에 들어간 원문·부산물
papers/**/source.pdf
papers/**/extract/
papers/**/01_extract/
papers/**/sources/
papers/**/export/
papers/*/work/*.pptx
*.pdf

# 비공개 저장소(paper-deck-private): private/ (실수로 papers/ 에 둔 90번대도 제외)
private/
papers/9[0-9]_*/

# 백업과 OS·편집기 파일
*.tar.gz
*.zip
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
__pycache__/
.venv/
